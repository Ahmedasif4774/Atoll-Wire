# Copy this file to .env.local and fill in your own Sanity project's values
# once you've run `npx sanity init` (see README.md, Phase 1).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Only needed for scripts that write to Sanity directly (not the
# NDJSON-based migrate-to-sanity.mjs, which uses `sanity dataset import`
# instead). Create one at manage.sanity.io -> API -> Tokens if you add one.
# SANITY_API_TOKEN=
